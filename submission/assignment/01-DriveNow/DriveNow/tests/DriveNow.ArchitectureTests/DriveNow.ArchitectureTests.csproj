<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DriveNow.Domain/DriveNow.Domain.csproj" />
    <ProjectReference Include="../../src/DriveNow.Application/DriveNow.Application.csproj" />
    <ProjectReference Include="../../src/DriveNow.Infrastructure/DriveNow.Infrastructure.csproj" />
    <ProjectReference Include="../../src/DriveNow.ConsoleApp/DriveNow.ConsoleApp.csproj" />
    <ProjectReference Include="../DriveNow.UnitTests/DriveNow.UnitTests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed source at build time so naming tests do not access real files at runtime.  this section take it from ai --> 
    <EmbeddedResource Include="../DriveNow.UnitTests/**/*.cs"
                      Exclude="../DriveNow.UnitTests/bin/**;../DriveNow.UnitTests/obj/**"
                      LogicalName="NamingSources.UnitTests.%(Filename)%(Extension)" />
    <EmbeddedResource Include="*.cs"
                      LogicalName="NamingSources.ArchitectureTests.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
